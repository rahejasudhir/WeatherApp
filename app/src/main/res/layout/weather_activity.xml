<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background_color"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".ui.weather.WeatherActivity">

    <RelativeLayout
        android:id="@+id/contentView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <android.support.v7.widget.AppCompatTextView
            android:id="@+id/current_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_56"
            android:gravity="center"
            android:text="@string/current_temp"
            android:lineSpacingExtra="@dimen/line_spacing_112"
            android:textSize="@dimen/font_size_96sp" />

        <android.support.v7.widget.AppCompatTextView
            android:id="@+id/wind_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/current_temp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_10"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/line_spacing_52"
            android:textSize="@dimen/font_size_36sp" />

        <ImageView
            android:id="@+id/cloud"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_cloud"
            android:visibility="gone"
            android:layout_below="@+id/wind_speed"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_10"
            android:gravity="center"/>

        <android.support.v7.widget.AppCompatTextView
            android:id="@+id/std_dev_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cloud"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_44"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/line_spacing_52"
            android:textSize="@dimen/font_size_36sp" />


        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/stdDevButton"
            android:layout_below="@+id/cloud"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_44"
            android:background="@color/button_bg_grey"
            android:gravity="center"
            android:text="@string/temp_data_text"
            android:textAllCaps="true"
            android:textColor="@color/white" />

        <ProgressBar
            android:id="@+id/std_progress"
            android:layout_below="@+id/cloud"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_44"
            android:indeterminate="true"
            android:visibility="gone"
            android:indeterminateDrawable="@drawable/progress_rotate" />

    </RelativeLayout>

    <include
        android:id="@+id/error_layout"
        layout="@layout/error_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        android:indeterminateDrawable="@drawable/progress_rotate" />

</LinearLayout>